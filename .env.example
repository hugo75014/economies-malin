# =============================================================================
# LLM Provider — pick ONE (or leave empty for mock / free demo)
# =============================================================================

# Option 1 — Groq (recommended for v0.1: free tier + very fast + cheap)
# Get a key: https://console.groq.com/keys
# Free tier: 30 req/min — enough for testing and small launches
# Models: llama-3.2-90b-vision-preview (vision), llama-3.1-8b-instant (text)
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview

# Option 2 — OpenAI (best quality, costs money)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option 3 — Anthropic (Claude, premium quality)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Supabase (Phase 2 — auth, DB, storage)
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Resend (transactional email)
# =============================================================================
# RESEND_API_KEY=
# FROM_EMAIL=hello@economies-malin.fr
